---
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../utils/readingTime.ts";

//Importing Blog Data
interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

//Date conversion
const date = post.data.date;
const labeledDate = date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});
const isoDate = date.toISOString().slice(0, 10);

//Reading time
const minutes = readingTime(post.body ?? "");
const readingTimeLabel = minutes < 1 ? "< 1 min" : Math.ceil(minutes) + " min";
//    condition ?   if true    :     if false
---

<article>
    <a href={`/${post.id}/`}>
        <h2>{post.data.title}</h2>
    </a>
    <p>{post.data.description}</p>
    <time datetime={isoDate}>{labeledDate}</time>
    <p>{readingTimeLabel}</p>
    <ul>
        {post.data.tags.map((tag) => (
            <li>{tag}</li>
        ))}
    </ul>
    {post.data.series && (
        <p>
            <span class="series">{post.data.series}</span>
        </p>
    )}
</article>
