---
import type { CollectionEntry } from "astro:content";
import { readingTime, formatReadingTimeLabel } from "../utils/readingTime.ts";
import { formatLabeledDate, formatIsoDate } from "../utils/formatDate.ts";
import { Image } from "astro:assets";

//Importing Blog Data
interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

//Date
const date = post.data.date;
const labeledDate = formatLabeledDate(date);
const isoDate = formatIsoDate(date);

//Reading time
const minutes = readingTime(post.body ?? "");
const readingTimeLabel = formatReadingTimeLabel(minutes);
---

<article class="h-full border border-text/10 rounded-md p-3">
    {post.data.featureImage ? (
        <Image src={post.data.featureImage} alt="" />
    ) : (
        <p>{post.data.description}</p>
    )}
    <a href={`/${post.id}/`}>
        <h2>{post.data.title}</h2>
    </a>
    <ul>
        {post.data.tags.map((tag) => (
            <li>{tag}</li>
        ))}
    </ul>
    <p>{readingTimeLabel}</p>
    <time datetime={isoDate}>{labeledDate}</time>
    {post.data.series && (
        <p>
            <span class="series">{post.data.series}</span>
        </p>
    )}
</article>
